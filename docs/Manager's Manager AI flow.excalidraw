      "text": "src = transcripts/session_1727.transcript.json   (없으면 단계 실패)\ntranscript = Transcript.from_dict(json.loads(src))\nnames = {e[\"user_id\"]: e[\"display_name\"]\n         for e in manifest[\"speakers\"]}\ntoday = meeting_date(manifest)     # 회의 날짜 = 마감일 계산 기준\n\nextractor(transcript, names, today)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "D3f4sgAE",
      "originalText": "src = transcripts/session_1727.transcript.json   (없으면 단계 실패)\ntranscript = Transcript.from_dict(json.loads(src))\nnames = {e[\"user_id\"]: e[\"display_name\"]\n         for e in manifest[\"speakers\"]}\ntoday = meeting_date(manifest)     # 회의 날짜 = 마감일 계산 기준\n\nextractor(transcript, names, today)",
      "autoResize": true,
      "lineHeight": 1.25,
      "rawText": "src = transcripts/session_1727.transcript.json   (없으면 단계 실패)\ntranscript = Transcript.from_dict(json.loads(src))\nnames = {e[\"user_id\"]: e[\"display_name\"]\n         for e in manifest[\"speakers\"]}\ntoday = meeting_date(manifest)     # 회의 날짜 = 마감일 계산 기준\n\nextractor(transcript, names, today)",
      "hasTextLink": false,
      "labelPosition": null

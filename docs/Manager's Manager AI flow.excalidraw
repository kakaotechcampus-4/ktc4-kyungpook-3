      "updated": 1790881372564,
      "link": null,
      "locked": false,
      "text": "SELECT task, embedding <=> :query AS distance\nFROM task\nWHERE workspace_id = 'ws_1'\n  AND status IN (todo, in_progress, blocked, done)\n  AND embedding IS NOT NULL\n  AND distance <= 1 - 0.4\nORDER BY distance LIMIT 3\n→ task_login 0.82 · task_social_login 0.61",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "CfEJ6jk8",
      "originalText": "SELECT task, embedding <=> :query AS distance\nFROM task\nWHERE workspace_id = 'ws_1'\n  AND status IN (todo, in_progress, blocked, done)\n  AND embedding IS NOT NULL\n  AND distance <= 1 - 0.4\nORDER BY distance LIMIT 3\n→ task_login 0.82 · task_social_login 0.61",
      "autoResize": true,
      "lineHeight": 1.25,
      "rawText": "SELECT task, embedding <=> :query AS distance\nFROM task\nWHERE workspace_id = 'ws_1'\n  AND status IN (todo, in_progress, blocked, done)\n  AND embedding IS NOT NULL\n  AND distance <= 1 - 0.4\nORDER BY distance LIMIT 3\n→ task_login 0.82 · task_social_login 0.61",
      "hasTextLink": false,
      "labelPosition": null
    },

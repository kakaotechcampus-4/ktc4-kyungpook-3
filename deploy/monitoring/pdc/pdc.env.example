# /etc/mm-monitoring/pdc.env 로 복사해 값을 채운다. root 소유, 권한 600(run-pdc.sh 가 600 이 아니면 멈춘다).
#   sudo install -m 0600 -o root -g root pdc.env.example /etc/mm-monitoring/pdc.env
# 값은 Grafana Cloud 포털의 Connections > Private data source connect 에서 에이전트 토큰을 만들 때 나온다.
# 이 파일의 실제 값은 저장소·문서·채팅에 붙이지 않는다.
GCLOUD_PDC_SIGNING_TOKEN=<PDC 토큰>
GCLOUD_PDC_CLUSTER=<PDC 클러스터 이름>
GCLOUD_HOSTED_GRAFANA_ID=<Grafana 스택 ID>

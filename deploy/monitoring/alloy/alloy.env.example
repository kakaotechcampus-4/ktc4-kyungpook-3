# /etc/mm-monitoring/alloy.env 로 복사해 값을 채운다. root 소유, 권한 600.
#   sudo install -d -m 0755 /etc/mm-monitoring
#   sudo install -m 0600 -o root -g root alloy.env.example /etc/mm-monitoring/alloy.env
# 값은 Grafana Cloud 포털의 스택 > Prometheus > Details 에서 확인한다. 토큰은 metrics:write 권한만 준다.
# 이 파일의 실제 값은 저장소·문서·채팅에 붙이지 않는다.
GCLOUD_RW_URL=<Prometheus 원격 쓰기 URL>
GCLOUD_RW_USER=<Prometheus 사용자 ID(숫자)>
GCLOUD_RW_TOKEN=<Access Policy 토큰, metrics:write 만>

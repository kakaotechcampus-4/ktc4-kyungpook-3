          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "실패 단계별 회의 수",
      "description": "어느 단계에서 실패했나. recovered 는 다시 녹음해 회복한 회의.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PG}"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PG}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT failed_stage AS \"실패 단계\", count(*) FILTER (WHERE NOT replaced) AS \"회복 못 함\", count(*) FILTER (WHERE replaced) AS \"다시 시도해 회복\" FROM kpi.meeting_fact WHERE status = 'failed' AND $__timeFilter(ended_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "데이터 없음"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "PM 응답 시간 (주별)",
      "description": "승인 카드가 생기고 PM 이 처리하기까지. p95 는 오래 걸린 쪽.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PG}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PG}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('week', resolved_at AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul' AS time, percentile_cont(0.5) WITHIN GROUP (ORDER BY response_seconds) AS p50, percentile_cont(0.95) WITHIN GROUP (ORDER BY response_seconds) AS p95 FROM kpi.approval_fact WHERE outcome IN ('approved','approved_edited','rejected') AND response_seconds IS NOT NULL AND $__timeFilter(resolved_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true,
            "drawStyle": "line"
          },
          "noValue": "데이터 없음"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "전사 오인식 의심별 PM 제목 수정 비율",
      "description": "의심(suspect) 카드에서 PM 이 제목을 더 자주 고치면 오인식 검사가 제 역할을 하는 것(멘토 PR #382). 11/7 이후 카드만.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PG}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PG}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT asr_flag AS \"오인식 검사\", count(*) AS \"카드 수\", 100.0 * avg(title_edited::int) AS \"제목 수정 비율(%)\" FROM kpi.approval_fact WHERE asr_flag IS NOT NULL AND outcome <> 'pending' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "데이터 없음"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "제목 수정 비율(%)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "회의 처리 중 메모리",
      "description": "워커와 서버 메모리. 주황 구간이 회의를 처리한 시간(워커가 처리를 시작해 추출을 등록하기까지)이다. 그 구간의 최대값이 회의 처리 중 최대 메모리.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "서버 사용 중"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          },
          "expr": "label_replace(container_memory_working_set_bytes{id=\"/system.slice/mm-worker.service\"}, \"svc\", \"워커\", \"id\", \".*\")",
          "legendFormat": "{{svc}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 6,
            "spanNulls": true,
            "drawStyle": "line"
          },
          "noValue": "데이터 없음"
        },
        "overrides": []
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_PG}"
        },
        "enable": true,
        "name": "회의 처리 구간",
        "iconColor": "orange",
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PG}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",

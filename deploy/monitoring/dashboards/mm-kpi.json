  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "auto 롤백률",
      "description": "auto 로 만든 태스크 중 PM 이 되돌린 비율(기획안 KPI, 목표 5% 이하). 되돌리기 제한 때문에 실제보다 낮게 나올 수 있다(하한값).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PG}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PG}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * avg(reverted::int) AS value FROM kpi.extraction_item_fact WHERE gate = 'auto' AND action = 'create' AND $__timeFilter(created_at)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 4
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "noValue": "데이터 없음"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "처리 시간 p95",
      "description": "녹음이 끝나고 태스크 후보가 등록되기까지. 느린 쪽 5% 를 뺀 최대값. 목표 10분. 하루(24시간) 넘게 잡힌 회의는 뺀다. 시드처럼 옛 날짜로 만든 회의나 오래된 녹음을 다시 처리한 회의라 실제 처리 시간이 아니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PG}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PG}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY processing_seconds - coalesce(speaker_wait_seconds, 0)) AS value FROM kpi.meeting_fact WHERE status = 'done' AND source IN ('discord','manual_upload') AND processing_seconds IS NOT NULL AND processing_seconds < 86400 AND $__timeFilter(ended_at)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 480
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          },
          "noValue": "데이터 없음"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "10분 넘은 회의",
      "description": "처리 시간이 10분을 넘은 회의 수. 하루(24시간) 넘게 잡힌 회의는 뺀다. 시드처럼 옛 날짜로 만든 회의나 오래된 녹음을 다시 처리한 회의라 실제 처리 시간이 아니다.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_PG}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_PG}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE processing_seconds - coalesce(speaker_wait_seconds, 0) > 600) AS value FROM kpi.meeting_fact WHERE status = 'done' AND source IN ('discord','manual_upload') AND processing_seconds IS NOT NULL AND processing_seconds < 86400 AND $__timeFilter(ended_at)"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"

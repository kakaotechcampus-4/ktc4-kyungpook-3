          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('week', created_at AT TIME ZONE 'Asia/Seoul') AT TIME ZONE 'Asia/Seoul' AS time, 100.0 * avg(reverted::int) AS \"롤백률\" FROM kpi.extraction_item_fact WHERE gate = 'auto' AND action = 'create' AND $__timeFilter(created_at) GROUP BY 1 ORDER BY 1"

# ── Discord (ai/capture 녹음 Cog, backend/bot 봇 프로세스, backend/bot/dm_sender 에서 사용) ──
# Developer Portal → Bot → Privileged Gateway Intents: SERVER MEMBERS 켜기
# MESSAGE CONTENT 는 포털에서 켠다. capture/chat_poll.py 가 REST 로 채널 메시지 본문을 읽는 데 필요하다.
# 코드(녹음 Cog, 실시간 Cog, chat_poll)는 이 intent 를 요청하지 않는다.
# 코드가 요청한 특권 인텐트를 포털에서 안 켜 두면 봇이 기동 즉시 죽는다
# 채팅 폴링도 이 토큰을 쓴다. 읽을 채널은 BE 가 알려 준다(GET /bot/chat-channels)
DISCORD_BOT_TOKEN=
# (선택) 슬래시 커맨드를 특정 서버에 즉시 등록하려면 길드 ID. 비우면 글로벌 등록(반영까지 최대 1시간)
DISCORD_GUILD_ID=
# (선택) 채팅 폴링: 참고 문맥 메시지 수 / 커서가 없을 때 되돌아볼 시간 / 한 번에 따라잡을 최대 일수(14 를 넘겨도 14)
CHAT_POLL_CONTEXT_MESSAGES=30
CHAT_POLL_INITIAL_HOURS=24
CHAT_POLL_MAX_DAYS=14

# ── Elice ML API (STT — stt/elice.py 가 os.environ 에서 직접 읽는다) ─────────
ELICE_API_KEY=
# 엔드포인트 화면의 https://mlapi.run/<엔드포인트 id> 를 넣는다 (/v1/audio/transcriptions 는 코드가 붙인다)
# 아래 *_BASE_URL 과 달리 끝에 /v1 을 붙이지 않는다. http:// 주소는 키가 평문으로 나가서 받지 않는다
ELICE_STT_BASE_URL=

# ── 수동 업로드 화자 분리 (upload/diarize.py, pyannoteAI 호스팅 API. upload/diarize.py 가 os.environ 에서 직접 읽는다) ──
PYANNOTEAI_API_KEY=

# ── 임베딩 전용 (Elice MLAPI, text-embedding-3-small. 비우면 검색 결과 없음으로 동작) ──
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://mlapi.run/b54ff33e-6d14-42df-93f9-0f1132160ee8/v1

# ── GPT-5.6 (Elice MLAPI, OpenAI 호환. 비우면 ai/ 는 규칙 기반 폴백으로 동작) ─
# Terra(판단, gpt-5.6-terra)와 Luna(초안, gpt-5.6-luna)는 엔드포인트·키가 서로 다름
TERRA_API_KEY=
TERRA_BASE_URL=https://mlapi.run/e1ede337-92cd-45f8-b0a1-f7d58d337268/v1
LUNA_API_KEY=
LUNA_BASE_URL=https://mlapi.run/286e9158-d32e-436d-a23d-36b43fc8e68a/v1
# Jev(근거 검증, typesafe/jev-latest). 대화형이 아닌 판정 API(POST /v1/decisions)라 jev.py 가 따로 부른다.
# judge 새 항목의 근거 상태를 묻는 데만 쓴다. 비우면 근거 상태는 모두 inferred 라 auto 가 열리지 않는다
JEV_API_KEY=
JEV_BASE_URL=https://mlapi.run/cff1ce3b-bf2a-4594-bd58-d3e910371290/v1

# ── 추출(Phase 1, extract/llm.py). 위와 같은 게이트웨이지만 엔드포인트가 또 다르다 ──
# 비우면 추출이 동작하지 않는다(규칙 기반 경로는 실측 후 제거했다)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_BASE_URL=

# ── BE 인계 (capture/handoff.py). 봇이 회의를 만들고 워커가 종료·발화 저장·추출 등록을 BE 회의 API 로 부른다 ──
# 아래 둘을 다 채워야 돈다. 비우면 전사와 추출까지만 하고 인계 단계에서 멈춘다 (채우고 워커를 다시 띄우면 잇는다)
# 워크스페이스는 설정하지 않는다. 회의마다 디스코드 서버로 BE 에 묻는다(웹 온보딩에서 서버를 연결한 워크스페이스)
BE_BASE_URL=
# 봇과 워커가 BE 에 보내는 모든 요청(회의 생성·종료·실패, 발화 저장, 추출 등록, 유사 task 검색)에 싣는 X-Service-Token.
# BE 의 SERVICE_TOKEN 과 같아야 한다. BE_BASE_URL 과 함께 둘 다 있어야 인계가 돈다
BE_SERVICE_TOKEN=
# 회의 시작 시각을 이 시간대의 날짜로 바꿔 "내일" 같은 상대 날짜의 기준일로 쓴다
MEETING_TIMEZONE=Asia/Seoul

# ── 추출 경로 (capture/recorder.py). 추출은 워커가 한다 ──
# 비우거나 legacy: extract/ 의 extract_tasks. judge: 판단 파이프라인(judge/pipeline.py).
# judge 는 TERRA_*, LUNA_*, BE_BASE_URL, BE_SERVICE_TOKEN 이 다 있어야 돈다. 하나라도 없으면
# 옛 경로로 넘어가지 않고 추출 단계에서 멈춘다. 모르는 값이면 워커가 시작할 때 멈춘다.
# 1단계가 고른 finding 가운데 판단하지 못한 것이 남으면 인계를 미루고 다시 돌린다. 그 횟수는 MM_EXTRACT_RETRY_MAX (기본 2)
MM_EXTRACT_PATH=

# ── Notion (backend/notion_sync) ──────────────────────────────────────────────
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ── 개발용 ───────────────────────────────────────────────────────────────────
# 상대 날짜("다음주 금요일") 해석 기준일 고정 (테스트/재현용, YYYY-MM-DD). 비우면 실제 오늘
PM_AGENT_TODAY=
# off 로 두면 키가 있어도 LLM 호출 안 함 (Terra/Luna/extract 공통. 임베딩과는 무관)
PM_AGENT_LLM=
# 1·on·true 면 워커가 채널에 단계 시작, 회의록 파일, 할 일 목록, 처리 시간·대기·최대 메모리 한 줄을 더 올린다.
# 개발에서 켜고 운영에서는 비운다. 단계가 끝났다는 알림(전사, 웹 회의록, 할 일, 웹에 올림)은 이 값과 상관없이 올린다
MM_DEBUG_REPORT=
# DEBUG 로 두면 capture/realtime/run.py 가 discord.voice 로거를 DEBUG 로 올린다 (버려진 패킷이 보인다).
# 운영 실행기 capture/run_recorder.py 는 이 값을 읽지 않는다
LOG_LEVEL=

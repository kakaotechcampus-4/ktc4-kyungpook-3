# ── Discord (ai/capture 녹음 Cog, be/bot 봇 프로세스, be/bot/dm_sender 에서 사용) ──
# Developer Portal → Bot → Privileged Gateway Intents: SERVER MEMBERS 켜기
# MESSAGE CONTENT 는 켜지 않는다. ai/capture 는 슬래시 명령만 쓰고 메시지 본문을 읽지 않는다
DISCORD_BOT_TOKEN=
# 회의 결과/승인 요청을 올릴 텍스트 채널 ID
DISCORD_CHANNEL_ID=
# (선택) 슬래시 커맨드를 특정 서버에 즉시 등록하려면 길드 ID. 비우면 글로벌 등록(반영까지 최대 1시간)
DISCORD_GUILD_ID=

# ── Elice ML API (STT) ───────────────────────────────────────────────────────
ELICE_API_KEY=

# ── Gemini (무료 티어만. 비우면 ai/ 는 규칙 기반 폴백으로 동작) ─────────────
GEMINI_API_KEY=
# gemini-2.5-flash-lite (기본) | gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Notion (be/notion_sync) ──────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ── 개발용 ───────────────────────────────────────────────────────────────────
# 상대 날짜("다음주 금요일") 해석 기준일 고정 (테스트/재현용, YYYY-MM-DD). 비우면 실제 오늘
PM_AGENT_TODAY=
# off 로 두면 GEMINI_API_KEY 가 있어도 LLM 호출 안 함
PM_AGENT_LLM=
# DEBUG 로 두면 run_recorder 가 discord.voice 로거를 DEBUG 로 올린다 (버려진 패킷이 보인다)
LOG_LEVEL=

# 비워 두면 동일 출처 /api/v1 이다. 개발 중에는 Vite proxy 가 /api 를 백엔드로 넘긴다
# 값을 주면 /api/v1 까지 포함한 API 루트 주소다. 예: https://api.example.com/api/v1
VITE_API_BASE_URL=

# MSW mock 사용 여부. 개발 서버에서만 의미가 있다 (true | false)
# 기본은 실제 API 다. 모의 데이터로 띄울 때만 true 로 바꾼다
VITE_ENABLE_MSW=false

# 개발 서버 proxy 가 /api 를 넘길 백엔드 주소. 개발 서버만 읽고 브라우저 번들에는 들어가지 않는다
# 비워 두면 http://localhost:8000 이다. 배포 백엔드에 붙일 때 예: https://managers-manager.duckdns.org
API_PROXY_TARGET=

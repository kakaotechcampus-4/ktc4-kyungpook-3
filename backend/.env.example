# 로컬 PostgreSQL (docker compose up -d db). 포트를 바꿨다면 URL의 5432도 같이 바꾼다.
DATABASE_URL=postgresql+psycopg://mm:mm@localhost:5432/mm
# 운영 compose(docker-compose.prod.yml)에서만 읽는다. 로컬 docker-compose.yml은 mm/mm 고정이다.
# 운영에서는 api 컨테이너의 DATABASE_URL을 이 세 값으로 다시 만들어서 위 값은 무시된다.
# 비밀번호는 URL에 그대로 들어가므로 영숫자로 정한다. 실제 값은 저장소에 올리지 않는다.
POSTGRES_USER=mm
POSTGRES_PASSWORD=
POSTGRES_DB=mm

# Notion 반영 워커 주기(초). 0이면 워커를 띄우지 않는다.
NOTION_SYNC_INTERVAL_SECONDS=5

# Notion OAuth 연결. Notion 개발자 페이지의 Public connection → Configuration 탭에서 복사한다.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Notion 연결 설정에 등록한 Redirect URI와 한 글자도 같아야 한다. 프론트와 같은 주소를 쓴다
# (로컬은 Vite 프록시가 /api를 백엔드로 넘긴다). 운영: https://<서비스 주소>/api/v1/integrations/notion/callback
NOTION_REDIRECT_URI=http://localhost:5173/api/v1/integrations/notion/callback
# OAuth state 서명 키(32자 이상, Notion client secret과 다른 값). 만들기:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# 가입 이메일 증명과 카카오 로그인의 서명·코드 해시에도 쓴다. 바꾸면 진행 중이던 연결(최대 10분)과
# 가입(코드는 최대 10분, 증명과 카카오 대기는 최대 30분)만 실패하고 저장된 연결은 그대로다. 실제 값은 저장소에 올리지 않는다.
OAUTH_STATE_SECRET=

# Discord 연결(봇 초대 OAuth)과 서버 사용자 목록. Discord 개발자 포털 → 앱 → OAuth2에서 복사한다.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# OAuth2 → Redirects에 등록한 값과 한 글자도 같아야 한다.
# 운영: https://<서비스 주소>/api/v1/integrations/discord/callback
DISCORD_REDIRECT_URI=http://localhost:5173/api/v1/integrations/discord/callback
# 녹음 봇(ai/.env의 DISCORD_BOT_TOKEN)과 같은 봇의 토큰. 서버 사용자 목록을 읽는다(Server Members Intent 필요).
# 실제 값은 저장소에 올리지 않는다.
DISCORD_BOT_TOKEN=
# 봇 초대 때 요청할 권한 값. 비우면 녹음 봇에 필요한 권한(app/services/discord_oauth.py)을 쓴다.
DISCORD_BOT_PERMISSIONS=

# 카카오 로그인. 카카오 개발자 콘솔 → 앱 → 앱 키의 REST API 키와, 카카오 로그인 → 보안의 Client Secret.
# 실제 값은 저장소에 올리지 않는다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 콘솔의 Redirect URI와 한 글자도 같아야 한다. 운영: https://<서비스 주소>/api/v1/auth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:5173/api/v1/auth/kakao/callback

# task 제목 임베딩 (text-embedding-3-small). AI 파트(ai/.env)와 같은 값을 쓴다.
# 비워 두면 임베딩 워커가 뜨지 않고, 유사 task 검색 API는 EMBEDDING_UNAVAILABLE(502)을 돌려준다.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 임베딩이 없는 task를 채우는 주기(초). 0이면 워커를 띄우지 않는다.
EMBEDDING_SYNC_INTERVAL_SECONDS=5

# 멈춘 업로드 회의(AI 처리 3시간 정체, 화자 지정 7일 대기)를 failed 로 정리하는 주기(초). 0이면 워커를 띄우지 않는다.
UPLOAD_SWEEP_INTERVAL_SECONDS=300

# 만료된 세션(session 표의 expires_at 이 지난 행)을 지우는 주기(초). 0이면 워커를 띄우지 않는다.
SESSION_SWEEP_INTERVAL_SECONDS=3600

# 디스코드 봇이 사용자 세션 없이 부르는 API(유사 task 검색)의 공유 비밀값.
# 봇은 X-Service-Token 헤더에 같은 값을 넣는다(AI 쪽 BE_SERVICE_TOKEN). 실제 값은 저장소에 올리지 않는다.
SERVICE_TOKEN=

# 구 봇 교체와 기존 녹음 계보 검증을 마친 뒤에만 정확히 true로 켠다.
MEETING_DELETION_ENABLED=false
# 삭제한 회의의 BE 파일 정리 재시도 간격. 0 이하면 주기 작업을 끈다.
MEETING_PURGE_INTERVAL_SECONDS=10

# 리마인드 스케줄러 주기(초). 0이면 워커를 띄우지 않는다.
REMINDER_SCHEDULER_INTERVAL_SECONDS=60

# 브라우저 푸시(VAPID). 셋 중 하나라도 비면 푸시를 보내지 않고 웹 안 알림만 쌓는다.
# 비공개키는 base64url 문자열이나 PEM 파일 경로. 실제 값은 저장소에 올리지 않는다. 키를 바꾸면 기존 구독은 다시 받아야 한다.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# mailto:주소 또는 경로 없는 https://호스트. 경로가 붙으면 서명이 거절된다.
VAPID_SUBJECT=

# 웹 녹음 업로드. 회의마다 UPLOAD_DIR/{meeting_id}/에 녹음을 둔다(참석자·파일 정보는 DB meeting_upload).
# 로컬은 비워 두면 backend/uploads를 쓴다(git이 무시한다). 운영은 compose가 /data/uploads(uploads 볼륨)로 정한다.
UPLOAD_DIR=
# 업로드 한도(바이트). 209715200 = 200MiB. 바꾸면 프론트 한도(uploadPolicy)도 같이 바꾼다.
UPLOAD_MAX_BYTES=209715200

# 회의 녹음 저장소(#659). local(기본, UPLOAD_DIR 디스크) 또는 s3. 운영은 s3 로 둔다.
# 로컬·테스트는 비워 두면 local 이다. 알 수 없는 값이나 s3 인데 버킷이 없으면 업로드·재생이 500 이다.
# 자격은 boto3 기본 체인으로 받는다. 운영 버킷은 팀 계정 밖(개인 AWS 계정)에 있어 EC2 인스턴스 역할을 못 쓰므로,
# 그 버킷의 meetings/* 만 쓸 수 있는 전용 IAM 사용자 키를 아래 두 줄에 넣는다(compose 가 이 파일을 통째로 넘긴다).
# 로컬·local 저장소에서는 비워 둔다. 키는 저장소에 커밋하지 않는다.
UPLOAD_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# UPLOAD_STORAGE=s3 일 때 버킷 이름(서울 리전). 키는 {UPLOAD_S3_PREFIX}{meeting_id}/audio.<확장자>.
UPLOAD_S3_BUCKET=
UPLOAD_S3_PREFIX=meetings/
# S3 클라이언트 리전. 프로세스당 한 번 만들어 쓰므로 바꾸면 api 컨테이너를 다시 띄운다.
AWS_REGION=ap-northeast-2
# 회의 녹음을 다시 듣게 두는 기간(일). 업로드는 받은 시각, 디스코드는 회의 종료 시각부터 센다. 처리 중이면 넘겨도 지우지 않는다.
UPLOAD_AUDIO_RETENTION_DAYS=7
# 재생 주소(S3 presigned URL)의 유효 시간(초). 재생 요청마다 새로 만든다.
UPLOAD_PLAYBACK_URL_TTL_SECONDS=3600

# 비밀번호 재설정·가입 인증 메일(SMTP). HOST·USERNAME·PASSWORD·APP_BASE_URL 이 모두 있어야 켜지고, 없으면 재설정 요청과 가입 코드 요청은 MAIL_UNAVAILABLE(503).
# Gmail 은 smtp.gmail.com, 587, starttls 에 계정의 앱 비밀번호를 쓴다. 실제 값은 저장소에 올리지 않는다.
SMTP_HOST=
SMTP_PORT=587
# starttls(기본, 587) 또는 ssl(465)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# 보내는 사람 표시. 비우면 SMTP_USERNAME. 예: Manager's Manager <team@gmail.com>
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
# 웹 주소(끝 / 없이). 재설정 링크 {APP_BASE_URL}/reset-password#token=... 와 봇 DM 안내의 대화 링크에 쓴다. 비면 DM 에 링크가 없다. 요청 헤더로 만들지 않는다.
APP_BASE_URL=

# 회의에서 뽑은 새 항목을 PM 확인 없이 태스크로 만들지(auto). false·0·off·no 면 auto 를 review 로 내린다(기본 켜짐).
# AI 검증(ai/.env 의 JEV_API_KEY)은 따로 돈다. 처음 운영은 끄고 검증 결과와 PM 승인·수정·반려를 본 뒤 여는 것을 권한다(#382).
# 모르는 값은 꺼짐으로 본다. 바꾸면 `docker compose -f docker-compose.prod.yml up -d` 로 컨테이너를 다시 만든다(restart 로는 반영 안 됨).
AUTO_CREATE_ENABLED=true
